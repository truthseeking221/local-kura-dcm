{
  "name": "@kura/ui-kit",
  "private": true,
  "version": "0.12.1",
  "type": "module",
  "sideEffects": false,
  "description": "Design tokens, theme, and React component primitives for Kura clinic apps (receptionist, phlebo, patient).",
  "engines": {
    "bun": ">=1.2"
  },
  "packageManager": "bun@1.3.11",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "ui:add": "shadcn add"
  },
  "exports": {
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/theme.css": "./src/styles/theme.css",
    "./assets/kura-logo.svg": "./src/assets/kura-logo.svg",
    ".": "./src/index.ts",
    "./atoms": "./src/components/atoms/index.ts",
    "./molecules": "./src/components/molecules/index.ts",
    "./organisms": "./src/components/organisms/index.ts",
    "./receptionist": "./src/components/modules/receptionist.ts",
    "./phlebo": "./src/components/modules/phlebo.ts",
    "./patient": "./src/components/modules/patient.ts",
    "./ui/*": "./src/components/ui/*.tsx",
    "./lib/cn": "./src/lib/cn.ts",
    "./lib/tokens": "./src/lib/tokens.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/noto-sans": "^5.2.6",
    "@fontsource/noto-sans-khmer": "^5.2.6",
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.14.0",
    "shadcn": "^4.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@eslint/js": "^10.0.1",
    "@geometricpanda/storybook-addon-badges": "^2.0.5",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-designs": "^11.1.3",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-themes": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "chromatic": "^16.9.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.3.6",
    "globals": "^17.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "storybook": "^10.3.6",
    "storybook-addon-pseudo-states": "^10.3.6",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
